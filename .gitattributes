# WinSap is a Windows / Visual Studio project: every text file is CRLF in the
# working tree. Declaring it here stops a checkout on another machine, or an
# editor that guesses, from silently rewriting whole files.

* text=auto eol=crlf

# Binary. Never touch these.
*.ico binary
*.exe binary
*.dll binary
*.pdb binary
*.wav binary
*.aps binary

# Generated by Visual Studio as UTF-16; leave the bytes alone.
*.rc  -text
